# Copy to .env.local and fill in values. Never commit .env.local.

# AI provider default when Settings has no override: auto | gemini | openai
AI_PROVIDER=auto

# Google Gemini — server only, no quotes around the key
# Get key: https://aistudio.google.com/apikey
# Verify: npm run verify:gemini
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL_TEXT=gemini-2.0-flash
GEMINI_MODEL_VISION=gemini-2.0-flash

# OpenAI — server only, no quotes around the key
# Verify: npm run verify:openai
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL_TEXT=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o

# Firebase client (from Firebase console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — prefer a JSON file (recommended for local dev):
# 1. Download service account JSON from Firebase Console
# 2. Save as firebase-service-account.json (gitignored)
# 3. Set:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or on Vercel: FIREBASE_SERVICE_ACCOUNT_KEY as a single-line JSON string

# MT5 bridge
NEXT_PUBLIC_BRIDGE_URL=http://localhost:8080
NEXT_PUBLIC_BRIDGE_MODE=direct

# Stripe ($50/month subscription)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Dev only: skip subscription gate
# SUBSCRIPTION_SKIP_IN_DEV=true
# SUBSCRIPTION_BYPASS_EMAILS=you@example.com

# Data provider keys (examples)
FINNHUB_API_KEY_1=
TWELVE_DATA_API_KEY_1=
NEWSDATA_API_KEY_1=

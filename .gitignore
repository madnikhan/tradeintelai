# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# mt5 bridge logs
mt5-bridge/*.log
*.log
!package.json
!package-lock.json

# local env files
.env*.local
.env*.local.bak
.env.bak

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# mt5 bridge file communication
mt5-commands/
mt5-responses/
command_*.json
response_*.json

# security - API keys (should never be committed)
*.key
*.pem
secrets/

# Firebase service account key (CRITICAL - contains private keys!)
*-firebase-adminsdk-*.json
firebase-adminsdk-*.json
*.json
!package.json
!package-lock.json
!tsconfig.json
!next.config.js
!tailwind.config.js
!postcss.config.js
!.eslintrc.json

mt5-commands
mt5-responses
config/api-keys.ts

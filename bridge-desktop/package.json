{
  "name": "tradeintel-bridge-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "tauri icon assets/logo.png",
    "prepare:resources": "bash scripts/prepare-resources.sh",

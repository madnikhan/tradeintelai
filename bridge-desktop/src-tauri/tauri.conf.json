{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeIntel Bridge",
  "version": "1.0.1",
  "identifier": "com.tradeintelai.bridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TradeIntel Bridge",
        "width": 480,
        "height": 720,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bridge/": "bridge/",
      "resources/python/": "python/",
      "resources/cloudflared/": "cloudflared/"
    },
    "shortDescription": "TradeIntel MT5 Bridge",
    "longDescription": "Runs the TradeIntel MT5 bridge with connectivity status in the system tray.",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}

# Dockerfile for MT5 Terminal with Wine
# Build: docker build -f Dockerfile.mt5 -t mt5-wine:latest .

FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Wine and dependencies
RUN apt-get update && apt-get install -y \
    wine64 \
    winetricks \
    xvfb \
    x11vnc \
    fluxbox \
    wget \
    curl \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Set up Wine environment
ENV WINEPREFIX=/root/.wine
ENV WINEARCH=win64
ENV DISPLAY=:99

# Initialize Wine prefix
RUN winecfg

# Install Windows dependencies
RUN winetricks -q corefonts vcrun2019

# Create directories for MT5
RUN mkdir -p /mt5/data /mt5/experts /mt5/scripts

# Copy MT5 installer (or download it)
# Option 1: Copy from host
# COPY mt5setup.exe /tmp/mt5setup.exe
# RUN wine /tmp/mt5setup.exe /S

# Option 2: Download MT5 installer
# RUN wget -O /tmp/mt5setup.exe https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe && \
#     wine /tmp/mt5setup.exe /S

# Copy EA and scripts
COPY MT5FileBridgeEA.mq5 /mt5/experts/
COPY start-mt5.sh /start-mt5.sh
RUN chmod +x /start-mt5.sh

# Set up Xvfb (virtual display)
RUN Xvfb :99 -screen 0 1024x768x24 &

# Expose ports (will be mapped in docker-compose)
EXPOSE 8080-8130

# Start script
CMD ["/start-mt5.sh"]


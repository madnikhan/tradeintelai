{
  "name": "tradeintelai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bridge": "node scripts/run-bridge.cjs",
    "multi-bridge": "./start-multi-bridge.sh",
    "dev": "next dev",
    "build": "node scripts/prepare-vercel-build.cjs && npm run build:bridge && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:gemini": "node scripts/verify-gemini-key.js",
    "verify:openai": "node scripts/verify-openai-key.js",
    "verify:firebase-admin": "node scripts/verify-firebase-admin.cjs",
    "build:bridge": "bash scripts/build-bridge-download.sh",
    "build:bridge-desktop": "cd bridge-desktop && npm run prepare:resources && npm run build:desktop",
    "vercel:env-sync": "node scripts/sync-env-to-vercel.cjs",
    "cloudflare": "./start-cloudflare.sh",
    "cloudflare:stop": "./stop-cloudflare.sh",
    "validate:production": "npm test && npx tsx scripts/compare-scan-trade-engines.ts EURUSD && npx tsx scripts/run-backtest-report.ts --offline",
    "backtest:report": "npx tsx scripts/run-backtest-report.ts",
    "audit:full": "npx tsx scripts/run-full-audit.ts",
    "audit:quick": "npx tsx scripts/run-full-audit.ts --skip-backtest --skip-gpt",
    "readiness:audit": "npx tsx scripts/run-production-readiness-audit.ts",
    "readiness:demo": "npx tsx scripts/check-demo-readiness.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.2.3",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "html2canvas": "^1.4.1",
    "next": "^14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.5.1",
    "stripe": "^22.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vitest": "^2.1.8"
  }
}
